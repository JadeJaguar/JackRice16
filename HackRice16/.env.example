PORT=3000
GEMINI_API_KEY=your_gemini_key_here
SERPAPI_KEY=your_serpapi_key_here
BACKBOARD_API_KEY=your_backboard_key_here
BACKBOARD_ASSISTANT_ID=
GROQ_API_KEY=your_groq_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Tiger Data connection string, from your Tiger Data project settings
DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require

# Same values your frontend already uses in its .env
# (VITE_SUPABASE_URL and VITE_SUPABASE_PUBLISHABLE_KEY), copied here
# so the backend can check login tokens the same way.
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
